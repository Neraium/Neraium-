{
  "name": "neraium-",
  "version": "1.0.0",
  "description": "This repository contains the static marketing website for Neraium.",
  "main": "scripts.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test",
    "build": "node scripts/build-static-site.mjs",
    "deploy": "node scripts/deploy-production.mjs",
    "preview": "npm run build && wrangler dev",
    "test:server": "node --test tests/contact.test.mjs",
    "check": "node --check scripts.js && node --check worker/index.mjs && node --check worker/contact.mjs && node --check worker/zoho-mail.mjs",
    "build:staging": "npm run build && node scripts/prepare-staging.mjs",
    "staging:dry-run": "wrangler deploy --config wrangler.staging.jsonc --dry-run --outdir artifacts/staging/worker",
    "preview:staging": "wrangler dev --config wrangler.staging.jsonc --port 4180 --ip 127.0.0.1",
    "verify:staging": "node scripts/verify-staging.mjs",
    "config:check": "node scripts/check-cloudflare-config.mjs",
    "test:public-writing": "node --test tests/public-writing.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neraium/Neraium-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Neraium/Neraium-/issues"
  },
  "homepage": "https://github.com/Neraium/Neraium-#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "undici": "7.30.0"
  }
}
